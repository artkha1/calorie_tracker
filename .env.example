# Get a free key at https://fdc.nal.usda.gov/api-guide
FDC_API_KEY=your_fdc_api_key_here

# Get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_string

# Optional: override the SQLite file path (defaults to storage/calorie_tracker.db)
# DATABASE_PATH=/path/to/your/calorie_tracker.db
